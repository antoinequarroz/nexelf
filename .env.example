# Copier en .env.local. Jamais commité.
# Sur Expo, seules les variables EXPO_PUBLIC_* arrivent dans l'app —
# et elles sont VISIBLES dans le bundle. Aucun secret ici.

# --- Convex -----------------------------------------------------------
# Fournies par `npx convex dev` au premier lancement.
EXPO_PUBLIC_CONVEX_URL=
EXPO_PUBLIC_CONVEX_SITE_URL=

# --- Monitoring -------------------------------------------------------
EXPO_PUBLIC_SENTRY_DSN=

# --- RevenueCat -------------------------------------------------------
# Clés publiques SDK, une par plateforme.
EXPO_PUBLIC_REVENUECAT_IOS=
EXPO_PUBLIC_REVENUECAT_ANDROID=

# --- À définir dans l'environnement CONVEX, pas ici --------------------
#   npx convex env set BETTER_AUTH_SECRET "..."
#   npx convex env set SITE_URL nexelf://
